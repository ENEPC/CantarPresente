# Copiar este archivo a .env y completar con los datos del proyecto Supabase.
# Dashboard Supabase → Connect → Connection string.

# Conexión directa (local y migraciones)
DATABASE_URL=postgresql://postgres.TU_PROJECT_REF:TU_PASSWORD@db.TU_PROJECT_REF.supabase.co:5432/postgres

# Pooler en modo transacción (usado por Vercel, puerto 6543)
DATABASE_URL_POOLED=postgresql://postgres.TU_PROJECT_REF:TU_PASSWORD@aws-0-TU_REGION.pooler.supabase.com:6543/postgres

# Puerto local (opcional, default 3001)
PORT=3001

# Vercel define VERCEL=1 automáticamente en producción; no setear local.
# VERCEL=1
